{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"files": {
		"includes": ["src/**/*.ts", "*.json", "!worker-configuration.d.ts"]
	}
}
